[Unit]
Description=WireGuard + Squid + WARP Setup
After=network.target
Wants=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/bin/sleep 5
ExecStart=/bin/bash -c '/usr/bin/warp-cli connect && /bin/systemctl start squid && /usr/bin/wg-quick up wg0'
ExecStop=/bin/bash -c '/usr/bin/wg-quick down wg0 && /bin/systemctl stop squid && /usr/bin/warp-cli disconnect'
ExecReload=/bin/bash -c '/usr/bin/wg-quick down wg0 && /usr/bin/wg-quick up wg0'

[Install]
WantedBy=multi-user.target